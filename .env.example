# ===== ASI:One LLM (optional but recommended - used for intent understanding, report parsing, plan explanation) =====
# Create a key at https://asi1.ai/dashboard/api-keys ; leave empty to use deterministic rules
ASI1_API_KEY=
# (alternative) any OpenAI-compatible provider
LLM_API_KEY=
LLM_BASE_URL=https://api.asi1.ai/v1
LLM_MODEL=asi1

# ===== Agent seeds: make these PRIVATE and unique (addresses derive from them). Never commit .env =====
INTAKE_SEED=
VERIFICATION_SEED=
RESOURCE_SEED=
ROUTING_SEED=
COORDINATOR_SEED=

# ===== Agentverse =====
# Only the Coordinator needs a mailbox to be reachable from ASI:One. Add <NAME>_MAILBOX=1 to register other agents too.
COORDINATOR_MAILBOX=1
# MAILBOX=1   # applies to ALL agents

# 1 = send reports through Intake->Verification->Resource->Routing agents; 0 = compute inside the Coordinator
CHAIN_MODE=1
CHAIN_TIMEOUT_S=20

# ===== Local dashboard / region =====
# RELIEF_DATA_DIR=./data
API_PORT=8080
